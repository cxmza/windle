{
  "name": "@windle/tokens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "windle design tokens: Tailwind 4 CSS-first tokens (tokens.css), font loading (fonts.css), sRGB palette mirrors for three.js/canvas (palette.ts).",
  "exports": {
    ".": "./src/palette.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
