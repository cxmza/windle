# /opt/windle/shared/api-migrate.env  (chmod 600 root). Read ONLY by the one-off `migrate` compose service
# (profile "migrate": `$DC --profile migrate run --rm migrate`). Generated by scripts/gen-secrets.sh.
# Owner role with DDL rights; never given to the long-running api.
DATABASE_MIGRATION_URL=postgres://windle_owner:<WINDLE_OWNER_PASSWORD>@postgres:5432/windle
