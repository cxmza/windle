# /opt/windle/shared/postgres.env  (chmod 600 root). Generated by scripts/gen-secrets.sh - never commit real values.
# POSTGRES_PASSWORD only matters on first init; later rotation is ALTER ROLE (see README "Rotate secrets").
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=windle
WINDLE_OWNER_PASSWORD=<openssl rand -hex 32>
WINDLE_APP_PASSWORD=<openssl rand -hex 32>
