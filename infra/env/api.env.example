# /opt/windle/shared/api.env  (chmod 600 root). Read by the long-running `api` compose service (profile "api").
# Generated by scripts/gen-secrets.sh. Full variable reference: apps/api/.env.example (zod config: apps/api/src/config.ts).
# Hostnames are compose service names: the api container reaches postgres/redis over the compose network.
# The owner (DDL) database URL is deliberately NOT here: it lives in api-migrate.env (one-off `migrate` service).
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Trust only the local nginx hop (X-Forwarded-For is overwritten by nginx with the real client IP).
# The compose network (172.18.0.0/16 today) is inside the docker bridge range 172.16.0.0/12.
TRUST_PROXY=127.0.0.1,::1,172.16.0.0/12

# runtime role (DML only), see compose/postgres/initdb/10-windle-roles.sh
DATABASE_URL=postgres://windle_app:<WINDLE_APP_PASSWORD>@postgres:5432/windle
# db 0 sessions + SIWS nonces, db 1 rate limits
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_RATE_LIMIT_URL=redis://:<REDIS_PASSWORD>@redis:6379/1

COOKIE_SECRET=<openssl rand -hex 32>
SESSION_COOKIE_NAME=wl_session
SESSION_COOKIE_DOMAIN=.windle.fun
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000

PUBLIC_WEB_ORIGIN=https://www.windle.fun
PUBLIC_APP_ORIGIN=https://app.windle.fun
PUBLIC_AUTH_ORIGIN=https://oauth.windle.fun
PUBLIC_API_ORIGIN=https://api.windle.fun
PUBLIC_DOCS_ORIGIN=https://docs.windle.fun
PUBLIC_CDN_ORIGIN=https://cdn.windle.fun
CORS_ALLOWED_ORIGINS=https://www.windle.fun,https://app.windle.fun,https://oauth.windle.fun,https://docs.windle.fun

# Sign-In With Solana: domain/uri written into the message; the wallet checks them against the sign-in page.
SIWS_DOMAIN=oauth.windle.fun
SIWS_URI=https://oauth.windle.fun

# >= 32 chars; unlocks /metrics with a Bearer token. nginx answers /metrics with 404 publicly anyway.
METRICS_TOKEN=<openssl rand -hex 32>

# imgproxy signing (same values as imgproxy.env) so the api can hand out signed cdn.windle.fun/img/ URLs.
# Required in production (user image URLs); gen-secrets.sh copies them from imgproxy.env.
IMGPROXY_KEY=<same as imgproxy.env>
IMGPROXY_SALT=<same as imgproxy.env>

# User images (POST /v1/media), see infra/README.md "Media pipeline". MEDIA_ROOT is set by compose
# (/srv/windle/media = host /opt/windle/media). Defaults shown.
# MEDIA_MAX_TOTAL_BYTES=16106127360
# MEDIA_UPLOADS_PER_DAY=40
# MEDIA_UPLOADS_PER_MINUTE=6
# MEDIA_MAX_CONCURRENT=1
# MEDIA_MAX_QUEUE=16
# webp: preset URLs pin WebP so Cloudflare caches them at the edge; auto: AVIF/WebP by Accept, origin-cached only.
# MEDIA_URL_FORMAT=webp
# Optional: Cloudflare purge by URL on admin takedown. API token scoped to this zone, permission Zone > Cache Purge.
# Both or neither; without them the api logs the URLs to purge by hand.
# CF_ZONE_ID=
# CF_API_TOKEN=

# X feed: services/x-relay over the compose network; open-stream caps per process / per client IP.
X_RELAY_URL=http://x-relay:3010
# X_FEED_MAX_STREAMS=1000
# X_FEED_MAX_STREAMS_PER_IP=8

# Full X post data for links users paste or open (GET /v1/x/post/:id?enrich=1) via twitterapi.io. Empty = off
# (the endpoint answers 503 x_enrich_unavailable, the plain relay lookup keeps working). Never commit or print a
# real key: it lives only in /opt/windle/shared/api.env (0600 root), see infra/README.md "X post enrichment".
TWITTERAPI_IO_KEY=
# Credits per UTC day (a tweet lookup ~15, an X article ~100); past it: 503 (cached posts still served).
# TWITTERAPI_DAILY_BUDGET=50000
# twitterapi.io lookups per client IP per minute (cache hits are free).
# X_ENRICH_RATE_LIMIT_PER_MINUTE=30

# Practice markets. Wallets (base58, comma-separated) that may resolve ANY market; empty = only each market's
# creator resolves its own. Admins should not trade: they could resolve markets they hold positions in.
ADMIN_WALLETS=
# Per-user write limits and the leaderboard cache (defaults shown).
# MARKET_CREATE_PER_HOUR=5
# MARKET_TRADE_PER_MINUTE=60
# LEADERBOARD_CACHE_SECONDS=15
# CANDLES_CACHE_SECONDS=3

# House market bots: open, labelled bot accounts ("Market bot #n", `bot: true` on every trade) that trade open
# markets around the price people set, so odds move between human trades. Never ranked, never counted as traders.
# Off unless true; one api instance trades at a time (Redis lease). See infra/README.md "Market bots".
BOTS_ENABLED=false
# Model and limits (defaults shown):
# BOTS_TICK_MS=20000
# BOTS_THETA_PER_HOUR=2
# BOTS_SIGMA=0.25
# BOTS_ANCHOR_ALPHA=0.5
# BOTS_ANCHOR_FOLLOW_PER_HOUR=1
# BOTS_MAX_STAKE_PTS=25
# BOTS_MAX_STEP_PP=3
# BOTS_DEAD_BAND_PP=1
# BOTS_COUNT=4
# BOTS_MARKETS_PER_TICK=3
# BOTS_QUIET_BEFORE_CLOSE_MINUTES=30

# Auth methods: SIWS on; the rest stay off until real keys exist (no fake keys).
AUTH_SIWS_ENABLED=true
AUTH_EMAIL_ENABLED=false
AUTH_X_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_TELEGRAM_ENABLED=false
AUTH_DISCORD_ENABLED=false
# Credentials, only when the matching flag is true (startup fails if they are missing):
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# DISCORD_CLIENT_ID= / DISCORD_CLIENT_SECRET=
