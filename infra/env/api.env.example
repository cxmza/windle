# /opt/windle/shared/api.env  (chmod 600 root). Read by the long-running `api` compose service (profile "api").
# Generated by scripts/gen-secrets.sh. Full variable reference: apps/api/.env.example (zod config: apps/api/src/config.ts).
# Hostnames are compose service names: the api container reaches postgres/redis over the compose network.
# The owner (DDL) database URL is deliberately NOT here: it lives in api-migrate.env (one-off `migrate` service).
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Trust only the local nginx hop (X-Forwarded-For is overwritten by nginx with the real client IP).
# The compose network (172.18.0.0/16 today) is inside the docker bridge range 172.16.0.0/12.
TRUST_PROXY=127.0.0.1,::1,172.16.0.0/12

# runtime role (DML only), see compose/postgres/initdb/10-windle-roles.sh
DATABASE_URL=postgres://windle_app:<WINDLE_APP_PASSWORD>@postgres:5432/windle
# db 0 sessions + SIWS nonces, db 1 rate limits
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_RATE_LIMIT_URL=redis://:<REDIS_PASSWORD>@redis:6379/1

COOKIE_SECRET=<openssl rand -hex 32>
SESSION_COOKIE_NAME=wl_session
SESSION_COOKIE_DOMAIN=.windle.fun
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000

PUBLIC_WEB_ORIGIN=https://www.windle.fun
PUBLIC_APP_ORIGIN=https://app.windle.fun
PUBLIC_AUTH_ORIGIN=https://oauth.windle.fun
PUBLIC_API_ORIGIN=https://api.windle.fun
PUBLIC_DOCS_ORIGIN=https://docs.windle.fun
PUBLIC_CDN_ORIGIN=https://cdn.windle.fun
CORS_ALLOWED_ORIGINS=https://www.windle.fun,https://app.windle.fun,https://oauth.windle.fun,https://docs.windle.fun

# Sign-In With Solana: domain/uri written into the message; the wallet checks them against the sign-in page.
SIWS_DOMAIN=oauth.windle.fun
SIWS_URI=https://oauth.windle.fun

# >= 32 chars; unlocks /metrics with a Bearer token. nginx answers /metrics with 404 publicly anyway.
METRICS_TOKEN=<openssl rand -hex 32>

# imgproxy signing (same values as imgproxy.env) so the api can hand out signed cdn.windle.fun/img/ URLs
IMGPROXY_KEY=<same as imgproxy.env>
IMGPROXY_SALT=<same as imgproxy.env>

# Auth methods: SIWS on; the rest stay off until real keys exist (no fake keys).
AUTH_SIWS_ENABLED=true
AUTH_EMAIL_ENABLED=false
AUTH_X_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_TELEGRAM_ENABLED=false
AUTH_DISCORD_ENABLED=false
# Credentials, only when the matching flag is true (startup fails if they are missing):
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# DISCORD_CLIENT_ID= / DISCORD_CLIENT_SECRET=
