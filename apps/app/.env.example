# Backend base URL (default: http://127.0.0.1:3001 in dev, https://api.windle.fun in prod)
# VITE_API_URL=http://127.0.0.1:3001

# X feed on the markets home. Unset = live stream (GET /v1/x/stream) with automatic fallback to the simulated feed.
# VITE_X_FEED=sample forces the simulated feed (offline work, demos).
# VITE_X_FEED=sample
