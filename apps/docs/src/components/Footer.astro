---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="wl-footer-note">
  windle is pre-launch. Mechanics described here are design and may change. Nothing on this site is financial, legal or
  investment advice. Read the <a href="/legal/risk/">risk disclosure</a>.
</p>

<style>
  .wl-footer-note {
    margin-top: 1.75rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid oklch(1 0 0 / 0.06);
    border-radius: 1rem;
    background: oklch(1 0 0 / 0.025);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.55;
  }
  .wl-footer-note a {
    color: var(--sl-color-gray-2);
    text-underline-offset: 0.2em;
  }
</style>
