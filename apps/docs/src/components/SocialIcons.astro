---
// Header social links. The X link is a placeholder rendered here instead of via Starlight's `social` config, because
// `social` derives a `twitter:site` meta tag from the URL and https://x.com has no handle (it would emit "@").
// Once windle has an X account: delete this override and add { icon: 'x.com', href: 'https://x.com/<handle>' } to
// `social` in astro.config.mjs.
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/SocialIcons.astro';

// TODO: the project's own X account; https://x.com is only the site root.
const X_URL = 'https://x.com';
---

<Default />
<a href={X_URL} rel="me" class="sl-flex wl-social">
  <span class="sr-only">windle on X</span>
  <Icon name="x.com" />
</a>

<style>
  .wl-social {
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
  }
  .wl-social:hover {
    opacity: 0.66;
  }
</style>
