---
// Header social links, kept in sync with SOCIALS in packages/brand/src/socials.ts (docs doesn't depend on @windle/brand:
// its barrel pulls in React components).
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const X_URL = 'https://x.com/windlepro';
const GITHUB_URL = 'https://github.com/cxmza/windle';
---

<Default />
<a href={X_URL} rel="me" class="sl-flex wl-social">
  <span class="sr-only">windle on X</span>
  <Icon name="x.com" />
</a>
<a href={GITHUB_URL} rel="me" class="sl-flex wl-social">
  <span class="sr-only">windle on GitHub</span>
  <Icon name="github" />
</a>

<style>
  .wl-social {
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
  }
  .wl-social:hover {
    opacity: 0.66;
  }
</style>
