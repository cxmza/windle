---
// Logo tiles for the brand kit page. The SVG is inlined from packages/brand (single source, currentColor), so each
// tile only sets a colour. Downloads point at the CDN copies served from infra/cdn/brand/.
// Relative path on purpose: @windle/brand is not (yet) a declared dependency of @windle/docs.
import markSvg from '../../../../packages/brand/assets/windle-mark.svg?raw';

const CDN = 'https://cdn.windle.fun/brand';
const tiles = [
  { name: 'Mark · blue', tone: 'blue', file: 'windle-mark-blue.svg', note: 'Primary. On black or deep navy.' },
  { name: 'Mark · white', tone: 'white', file: 'windle-mark-white.svg', note: 'On blue, photos or dark surfaces.' },
  { name: 'Mark · black', tone: 'black', file: 'windle-mark-black.svg', note: 'On white and light surfaces.' },
  { name: 'App icon', tone: 'icon', file: 'windle-app-icon.svg', note: 'Avatars and app tiles.' },
] as const;
---

<div class="wl-marks not-content">
  {
    tiles.map((t) => (
      <article class={`wl-mark wl-mark--${t.tone}`}>
        <div class="wl-mark__art" set:html={markSvg} />
        <h3>{t.name}</h3>
        <p>{t.note}</p>
        <a href={`${CDN}/${t.file}`} download>
          Download SVG
        </a>
      </article>
    ))
  }
</div>

<style>
  .wl-marks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .wl-mark {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: 1rem;
    border: 1px solid var(--wl-navy-line);
    border-radius: 0.25rem;
    background: var(--wl-navy);
  }
  .wl-mark__art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-bottom: 0.5rem;
    border-radius: 0.125rem;
    background: var(--sl-color-black);
  }
  .wl-mark__art :global(svg) {
    width: 4.5rem;
    height: 4.5rem;
  }
  .wl-mark--blue .wl-mark__art {
    color: var(--blue-500);
  }
  .wl-mark--white .wl-mark__art {
    color: var(--gray-900);
    background: var(--blue-400);
  }
  .wl-mark--black .wl-mark__art {
    color: var(--gray-0);
    background: var(--gray-900);
  }
  /* app icon = the blue mark at 80% on a near-black rounded square (mirrors infra/cdn/brand/windle-app-icon.svg) */
  .wl-mark--icon .wl-mark__art {
    background: var(--blue-100);
  }
  .wl-mark--icon .wl-mark__art :global(svg) {
    box-sizing: border-box;
    padding: 0.45rem;
    border-radius: 22%;
    color: var(--blue-500);
    background: var(--gray-50);
  }
  .wl-mark h3 {
    margin: 0;
    font-family: var(--wl-font-display);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .wl-mark p {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .wl-mark a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-accent);
  }
</style>
