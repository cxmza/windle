# windle api - every environment variable it reads (src/config.ts validates them at startup and fails fast).
# (Named env.example rather than .env.example only because the agent tooling may not write dotenv files; rename freely.)
# Production values live in /opt/windle/shared/api.env (see infra/env/api.env.example).
# Empty or unset = the default shown. Values below are dev defaults or placeholders - never real secrets.

# --- process -------------------------------------------------------------------------------------------------------
# development | test | production. Production switches on: required DATABASE_URL/REDIS_URL, cookie Domain=.windle.fun
# + Secure, prod-only CORS origins, oauth.windle.fun as SIWS domain, generic 500 messages.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Optional build id shown on GET / (the Docker image sets it from --build-arg APP_COMMIT).
APP_COMMIT=

# --- network -------------------------------------------------------------------------------------------------------
# Hops whose X-Real-IP / CF-Connecting-IP / X-Forwarded-For are believed (IPs or CIDRs, comma-separated).
# Default: 127.0.0.1,::1,172.16.0.0/12 (host nginx + docker bridge gateway in front of the container).
TRUST_PROXY=
# Exact origins allowed for credentialed CORS and as Origin/Referer of state-changing requests (CSRF check).
# Default (production): https://www.windle.fun,https://app.windle.fun,https://oauth.windle.fun,https://docs.windle.fun
# Default (development/test): the above + http://localhost|127.0.0.1 on 5173,5174,5175,5176,4321.
CORS_ALLOWED_ORIGINS=
# Public URLs used in GET / and the OpenAPI `servers` entry. Defaults: https://api.windle.fun (prod) /
# http://localhost:$PORT (dev), https://docs.windle.fun.
PUBLIC_API_ORIGIN=
PUBLIC_DOCS_ORIGIN=
# Sign-in app origin; SIWS_URI / SIWS_DOMAIN default from it. Default: https://oauth.windle.fun (prod),
# http://localhost:5175 (dev).
PUBLIC_AUTH_ORIGIN=
# Max request body in bytes (default 16384; nginx caps at 1 MB in front).
BODY_LIMIT_BYTES=16384

# --- data ----------------------------------------------------------------------------------------------------------
# Runtime role (DML only). Required in production. Dev default: postgres://windle:windle@127.0.0.1:5432/windle
DATABASE_URL=postgres://windle:windle@127.0.0.1:5432/windle
# Owner role (DDL). Read ONLY by `node dist/migrate.js` / `npm run db:migrate`; falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Postgres pool size per process (default 10).
DATABASE_POOL_MAX=10
# Sessions + SIWS nonces. Required in production. Dev default: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# Rate-limit counters (separate logical db recommended). Falls back to REDIS_URL.
REDIS_RATE_LIMIT_URL=

# --- sessions ------------------------------------------------------------------------------------------------------
# Cookie name is fixed by @windle/shared (wl_session); any other value is rejected.
SESSION_COOKIE_NAME=wl_session
# Default: .windle.fun in production, unset (host-only) in development.
SESSION_COOKIE_DOMAIN=
# true | false. Default: true in production (cannot be false there), false in development (http://localhost).
SESSION_COOKIE_SECURE=
# Sliding idle lifetime, renewed on every authenticated read (default 30 days).
SESSION_TTL_SECONDS=2592000
# Hard ceiling from sign-in, however active the session is (default 90 days, must be >= SESSION_TTL_SECONDS).
SESSION_ABSOLUTE_TTL_SECONDS=7776000
# Accepted but unused today: sessions are opaque random tokens looked up server-side (nothing to sign).
COOKIE_SECRET=

# --- Sign-In With Solana -------------------------------------------------------------------------------------------
# `domain` and `uri` written into the SIWS message; the wallet checks domain against the page origin.
# Defaults: derived from PUBLIC_AUTH_ORIGIN (oauth.windle.fun / http://localhost:5175).
SIWS_DOMAIN=
SIWS_URI=
SIWS_STATEMENT=Sign in to windle
# mainnet | devnet | testnet
SIWS_CHAIN_ID=mainnet
# Nonce lifetime = message expirationTime - issuedAt (default 300).
SIWS_NONCE_TTL_SECONDS=300

# --- auth providers (only SIWS is implemented; others answer 501 provider_disabled) --------------------------------
AUTH_SIWS_ENABLED=true
AUTH_EMAIL_ENABLED=false
AUTH_X_ENABLED=false
AUTH_GOOGLE_ENABLED=false
# Required when the matching flag is true (startup fails otherwise). Never put placeholder keys here.
EMAIL_FROM=
SMTP_URL=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- abuse limits (per client IP, Redis-backed) --------------------------------------------------------------------
# Global per-IP requests per window (default 300).
RATE_LIMIT_MAX=300
# Stricter limit for nonce/verify/provider-start routes (default 20).
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- observability -------------------------------------------------------------------------------------------------
# Optional, >= 32 chars. Unlocks /metrics with `Authorization: Bearer <token>` from anywhere; without it /metrics
# answers only direct (non-proxied) requests from loopback / TRUST_PROXY hops.
METRICS_TOKEN=

# --- tests ---------------------------------------------------------------------------------------------------------
# src/integration.test.ts runs only when both are set (use a scratch database + spare Redis db index).
# INTEGRATION_DATABASE_URL=
# INTEGRATION_DATABASE_MIGRATION_URL=
# INTEGRATION_REDIS_URL=
